  "formAnswers": {
    "comment": "First matching rule whose answer fits the question type wins. Tokens: {{members}}, {{mobileIntl}} (the group contact's phone) and {{district}} (from upload), {{idType}}; generated fresh for every question: {{idNumber}} (unique NRC), {{tpin}} (unique TPIN), {{mobile}} (unique Zambian mobile), {{firstName}} / {{lastName}} / {{fullName}} (from client.names). Dates: dob (random age in client.dobAgeYears), daysAgo:N, daysAhead:N, monthsAgo:N, monthsAhead:N.",
    "rules": [
      {
        "pattern": "\\btpin\\b|tax payer",
        "answer": { "number": "{{tpin}}" }
      },
      { "pattern": "vfz group id", "answer": { "number": "12" } },
      {
        "pattern": "politically exposed|\\bpep\\b",
        "answer": { "bool": "No" }
      },
      {
        "pattern": "date of birth|\\bdob\\b|birth date",
        "answer": { "date": "dob" }
      },
      {
        "pattern": "issued? date|date of issue|issued on",
        "answer": { "date": "daysAgo:30" }
      },
      {
        "pattern": "previous cycle.?s share-out amount",
        "answer": { "number": "100000" }
      },
      { "pattern": "requested loan amount", "answer": { "number": "20000" } },
      { "pattern": "maximum amount allowed", "answer": { "number": "100000" } },
      { "pattern": "loan term", "answer": { "number": "3" } },
      {
        "pattern": "current cycle.?s share-out date",
        "answer": { "date": "monthsAhead:5" }
      },
      {
        "pattern": "next share-out|upcoming",
        "answer": { "date": "daysAhead:30" }
      },
      {
        "pattern": "group opening date",
        "answer": { "date": "monthsAgo:2" }
      },
      {
        "pattern": "identity type|id type|type of id|identification type",
        "answer": { "option": "{{idType}}" }
      },
      {
        "pattern": "nrc|id number|identity number|identification number|national id",
        "answer": { "text": "{{idNumber}}" }
      },
      {
        "pattern": "phone number of the main contact",
        "answer": { "text": "{{mobileIntl}}" }
      },
      {
        "pattern": "phone|mobile|telephone|contact number",
        "answer": { "text": "{{mobile}}" }
      },
      { "pattern": "nationality|country code", "answer": { "text": "ZM" } },
      {
        "pattern": "^first name|given name",
        "answer": { "text": "{{firstName}}" }
      },
      {
        "pattern": "^surname|last name|family name",
        "answer": { "text": "{{lastName}}" }
      },
      {
        "pattern": "next of kin name|^facilitator$",
        "answer": { "text": "{{fullName}}" }
      },
      { "pattern": "^district$", "answer": { "text": "{{district}}" } },
      {
        "pattern": "^street$|street is the group|next of kin address",
        "answer": { "text": "Plot 12, Cairo Road" }
      },
      {
        "pattern": "purpose of the loan",
        "answer": { "text": "Expand the group's farming business" }
      },
      {
        "pattern": "written off|defaulted|overdue|arrears",
        "answer": { "number": "0" }
      },
      {
        "pattern": "present today|members present",
        "answer": { "number": "{{members}}" }
      },
      {
        "pattern": "new in this saving cycle|new members",
        "answer": { "number": "0" }
      },
      { "pattern": "attended", "answer": { "number": "{{members}}" } },
      {
        "pattern": "previous saving cycle|participated in the previous",
        "answer": { "number": "{{members}}" }
      },
      {
        "pattern": "^number of members|members in group",
        "answer": { "number": "{{members}}" }
      },
      { "pattern": "how many|number of|count", "answer": { "number": "3" } },
      { "pattern": "amount|value|share|savings", "answer": { "number": "100" } }
    ],
    "uniquePerForm": ["position in the group"],
    "defaults": {
      "bool": "Yes",
      "rating": "5",
      "text": "QA Test",
      "number": "100",
      "date": "daysAgo:30"
    }
